# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se versiona (lo ignora la regla .env* de .gitignore).

# API key de Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Dirección que recibe los mensajes del formulario de contacto.
# OJO: el remitente es el sandbox de Resend (onboarding@resend.dev), que solo
# entrega a la dirección dueña de la cuenta de Resend. En desarrollo usa esa
# misma dirección o el correo saldrá OK por API pero no llegará a ningún lado.
CONTACT_TO_EMAIL=tu-correo@ejemplo.com
